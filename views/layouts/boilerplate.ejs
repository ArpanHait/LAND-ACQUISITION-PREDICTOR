<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/images/Logo_Design.png">
    <title>BhoomiAI - Land Acquisition Delay Predictor</title>
    <!-- Google Fonts: Noto Sans, Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons 1.11.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom GovTech Stylesheet -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- Top Sticky Navigation Bar  -->
    <!-- <nav class="navbar navbar-expand-lg navbar-dark navbar-govtech sticky-top"> -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-govtech ">
        <div class="container-fluid px-3 px-lg-4 px-xl-5">
            <a class="brand-logo me-3 me-lg-4" href="/">
                <img src="/images/Logo_Design.png" alt="BhoomiAI Logo" class="brand-logo-img">
                <span>Bhoomi<span class="text-teal">AI</span></span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link-gov" href="/"><i class="bi bi-house-door"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-gov" href="/predict"><i class="bi bi-plus-circle"></i> New Assessment</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-gov" href="/dashboard"><i class="bi bi-bar-chart-line"></i> Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-gov" href="/map"><i class="bi bi-map"></i> GIS Map</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-gov" href="/alerts"><i class="bi bi-bell"></i> Alerts</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-gov" href="/history"><i class="bi bi-clock-history"></i> History</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3 ms-auto">
                    <div class="status-badge-engine d-none d-md-inline-flex">
                        <span class="pulse-indicator"></span>
                        <i class="bi bi-cpu" style="color: #1ED760;"></i>
                        <span>Dual XGBoost v1.5 Active (95.3% Accuracy)</span>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Body -->
    <main class="flex-grow-1">
        <%- body %>
    </main>

    <!-- Footer Component -->
    <footer class="footer-govtech">
        <div class="container">
            <div class="row align-items-center justify-content-between gy-3">
                <div class="col-lg-7">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <img src="/images/Logo_Design.png" alt="BhoomiAI Logo" class="footer-logo-img">
                        <span class="footer-title">BhoomiAI</span>
                    </div>
                    <div class="footer-subtitle">
                        • Ministry of Railways & Road Infrastructure
                    </div>
                </div>
                <div class="col-lg-5 text-lg-end">
                    <div class="tech-stack-badges justify-content-lg-end">
                        <span class="tech-badge">
                            <i class="bi bi-lightning-charge-fill"></i> FastAPI Microservice
                        </span>
                        <span class="tech-badge">
                            <i class="bi bi-cpu-fill"></i> XGBoost ML
                        </span>
                        <span class="tech-badge">
                            <i class="bi bi-database-fill"></i> MongoDB
                        </span>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <div>
                    © 2026 BhoomiAI - Land Acquisition Delay Predictor
                </div>
                <div class="d-flex gap-3">
                    <span>CALA Portal Integration</span>
                    <span>•</span>
                    <span>NHAI & MoR Compliant</span>
                    <span>•</span>
                    <span>GovTech Security Standards</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="/js/script.js"></script>
</body>

</html>