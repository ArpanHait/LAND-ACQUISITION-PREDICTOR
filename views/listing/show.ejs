<% layout('layouts/boilerplate') %>

<%
// Safe fallback initialization to prevent any ReferenceError or TypeError
const item = (typeof caseItem !== 'undefined' && caseItem) ? caseItem : {
    case_id: 'DEMO-LA-2026',
    project_name: 'High-Speed Infrastructure Corridor',
    state: 'Uttar Pradesh',
    district_type: 'Rural',
    project_type: 'Railway',
    land_type: 'Agricultural',
    notification_stage: '3A issued',
    land_area_acres: 8.2,
    land_area_hectares: 3.32,
    affected_owner_count: 12,
    compensation_estimate_inr_lakh: 350.0,
    compensation_funding_available: 0,
    is_multi_village: 1,
    days_since_case_opened: 240,
    award_completed_percent: 30.0,
    compensation_disbursed_percent: 15.0,
    possession_completed_percent: 0.0,
    delay_probability: 0.911,
    delay_probability_percent: '91.1%',
    risk_level: 'High',
    is_delayed_predicted: 1,
    risk_distribution: { low: 0.002, medium: 0.011, high: 0.988 },
    top_risk_factors: [
        'Active court litigation pending',
        'Ownership title dispute among claimants',
        'Section 3C/Section 15 public objections filed',
        'Compensation funds not yet deposited in escrow'
    ],
    recommended_preventive_actions: [
        'Prioritize government legal counsel hearings and consider Section 64 reference fast-tracking.',
        'Deposit disputed share into competent authority court escrow while proceeding with uncontested parcels.',
        'Convene direct CALA hearing to address objections on valuation and alignment.',
        'Expedite budgetary sanction and treasury transfer to avoid statutory compensation interest penalty.'
    ],
    processing_time_ms: 57.8,
    warning: null
};

const riskLevel = item.risk_level || 'Medium';
const riskClass = riskLevel.toLowerCase();
const riskDist = item.risk_distribution || { low: 0, medium: 0, high: 0 };
const factors = Array.isArray(item.top_risk_factors) ? item.top_risk_factors : [];
const actions = Array.isArray(item.recommended_preventive_actions) ? item.recommended_preventive_actions : [];
const shapData = Array.isArray(item.shap_explanations) ? item.shap_explanations : [];
const probPercent = item.delay_probability_percent || `${Math.round((item.delay_probability || 0) * 100)}%`;
const probVal = typeof item.delay_probability === 'number' ? item.delay_probability : 0.5;
const progressWidth = Math.min(Math.max(Math.round(probVal * 100), 0), 100);
const progressWidthPercent = `${progressWidth}%`;

const lowDistPercent = `${((riskDist.low || 0) * 100).toFixed(1)}%`;
const medDistPercent = `${((riskDist.medium || 0) * 100).toFixed(1)}%`;
const highDistPercent = `${((riskDist.high || 0) * 100).toFixed(1)}%`;
const awardPercentStr = `${item.award_completed_percent || 0}%`;
const possessionPercentStr = `${item.possession_completed_percent || 0}%`;
%>

<div class="container-fluid py-3 px-3 px-lg-4" style="max-width: 1250px;">

    <% if (item.warning) { %>
        <div class="alert alert-dismissible fade show rounded-3 mb-3 p-2.5 px-3" role="alert" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); color: #FDE68A; font-size: 0.82rem;">
            <i class="bi bi-exclamation-circle-fill me-1.5 text-warning"></i> <strong>Notice:</strong> <%= item.warning %>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Result Header Card (Dark with Soft Risk Accent) -->
    <div class="card border-0 rounded-3 overflow-hidden mb-3 show-header-card risk-<%= riskClass %>">
        <div class="p-3 p-md-4 text-white show-header-banner risk-<%= riskClass %>">
            <div class="row align-items-center gy-2">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-1.5 mb-1.5">
                        <span class="badge px-2 py-0.5 rounded-pill fw-bold" style="background: #121212; color: #38BDF8; border: 1px solid rgba(255,255,255,0.08); font-family: monospace; font-size: 0.72rem;">
                            <i class="bi bi-folder2 me-1"></i> <%= item.case_id || 'N/A' %>
                        </span>
                        <span class="badge px-2 py-0.5 rounded-pill fw-bold risk-badge-pill risk-<%= riskClass %>" style="font-size: 0.7rem;">
                            <%= riskLevel.toUpperCase() %> RISK
                        </span>
                    </div>
                    <h4 class="fw-bold mb-1 text-white"><%= item.project_name || 'Land Acquisition Project' %></h4>
                    <p class="mb-0 text-muted small" style="font-size: 0.8rem;">
                        <i class="bi bi-geo-alt me-1 text-teal"></i> <%= item.state || 'N/A' %> (<%= item.district_type || 'N/A' %>) • Sector: <%= item.project_type || 'N/A' %> • Land: <%= item.land_area_acres || 0 %> Acres (<%= item.land_area_hectares || 0 %> Ha)
                    </p>
                </div>
                <div class="col-md-4 text-md-end">
                    <div class="d-inline-block p-2 px-3 rounded-3 text-center" style="background: #141414; border: 1px solid rgba(255, 255, 255, 0.08);">
                        <span class="text-muted small text-uppercase fw-semibold d-block" style="font-size: 0.68rem; letter-spacing: 0.03em;">Assigned Risk Tier</span>
                        <h4 class="fw-bold mb-0 text-risk-<%= riskClass %>">
                            <%= riskLevel %> Risk
                        </h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="p-3 border-top" style="background: #181818; border-color: rgba(255, 255, 255, 0.08) !important;">
            <div class="row g-3 align-items-center">
                <div class="col-md-4 text-center border-end" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                    <span class="small fw-semibold text-uppercase text-muted" style="font-size: 0.7rem; letter-spacing: 0.03em;">Delay Probability</span>
                    <h2 class="fw-bold mb-1 text-risk-<%= riskClass %>">
                        <%= probPercent %>
                    </h2>
                    <div class="progress mt-1.5 mx-auto" style="height: 6px; max-width: 140px; background-color: #121212; border-radius: 999px;">
                        <div id="delayProgressBar"
                             class="progress-bar progress-bar-risk-<%= riskClass %>" 
                             role="progressbar" 
                             aria-valuenow="<%= progressWidth %>" 
                             aria-valuemin="0" 
                             aria-valuemax="100" 
                             data-width="<%= progressWidth %>">
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-center border-end" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                    <span class="small fw-semibold text-uppercase text-muted" style="font-size: 0.7rem; letter-spacing: 0.03em;">Probability Breakdown</span>
                    <div class="d-flex justify-content-center gap-3 mt-1.5">
                        <div>
                            <span class="badge" style="background: rgba(16, 185, 129, 0.12); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.25); font-size: 0.68rem;">Low</span>
                            <div class="fw-bold text-white mt-0.5" style="font-size: 0.82rem;"><%= lowDistPercent %></div>
                        </div>
                        <div>
                            <span class="badge" style="background: rgba(245, 158, 11, 0.12); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.25); font-size: 0.68rem;">Medium</span>
                            <div class="fw-bold text-white mt-0.5" style="font-size: 0.82rem;"><%= medDistPercent %></div>
                        </div>
                        <div>
                            <span class="badge" style="background: rgba(239, 68, 68, 0.12); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.25); font-size: 0.68rem;">High</span>
                            <div class="fw-bold text-white mt-0.5" style="font-size: 0.82rem;"><%= highDistPercent %></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    <span class="small fw-semibold text-uppercase text-muted" style="font-size: 0.7rem; letter-spacing: 0.03em;">Inference Latency</span>
                    <h4 class="fw-bold mb-1 text-white"><%= item.processing_time_ms || 0 %> ms</h4>
                    <span class="badge px-2.5 py-1" style="background: #121212; color: #CBD5E1; border: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.7rem;">Sub-second Realtime</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Details and Action Columns -->
    <div class="row g-3">
        
        <!-- Left: Bottleneck Drivers & Mitigations -->
        <div class="col-lg-7">
            <!-- Top Risk Factors -->
            <div class="card border-0 rounded-3 p-3 mb-3" style="background: #1E1E1E;">
                <h6 class="fw-bold text-white mb-2.5" style="font-size: 0.88rem;">
                    <i class="bi bi-exclamation-octagon-fill me-1.5" style="color: #F87171;"></i> Identified Critical Bottlenecks
                </h6>
                <% if (factors.length > 0) { %>
                    <div class="d-flex flex-column gap-1.5">
                        <% factors.forEach(function(factor) { %>
                            <div class="d-flex align-items-center p-2 px-2.5 rounded-2" style="background: #141414; border: 1px solid rgba(255, 255, 255, 0.06); font-size: 0.82rem;">
                                <i class="bi bi-x-circle-fill me-2 fs-6" style="color: #F87171;"></i>
                                <span class="fw-semibold text-white"><%= factor %></span>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="text-muted small mb-0">No severe bottleneck triggers identified.</p>
                <% } %>
            </div>

            <!-- SHAP Explainability Chart -->
            <% if (shapData.length > 0) { %>
            <div class="card border-0 rounded-3 p-3 mb-3" style="background: #1E1E1E;">
                <h6 class="fw-bold text-white mb-1" style="font-size: 0.88rem;">
                    <i class="bi bi-diagram-3-fill text-teal me-1.5"></i> AI Explainability (SHAP)
                </h6>
                <p class="small mb-2 text-muted" style="font-size: 0.74rem;">How each feature contributes to the predicted delay probability.</p>
                <div style="height: 200px; position: relative;">
                    <canvas id="shapChart"></canvas>
                </div>
                <div class="d-flex gap-3 mt-2" style="color: #94A3B8; font-size: 0.72rem;">
                    <span><span style="display:inline-block;width:10px;height:10px;background:#EF4444;border-radius:2px;margin-right:4px;"></span>Increases delay risk</span>
                    <span><span style="display:inline-block;width:10px;height:10px;background:#10B981;border-radius:2px;margin-right:4px;"></span>Reduces delay risk</span>
                </div>
            </div>
            <% } %>

            <!-- Recommended Preventive Actions -->
            <div class="card border-0 rounded-3 p-3" style="background: #1E1E1E; border-left: 3px solid #06B6D4 !important;">
                <h6 class="fw-bold text-white mb-2.5" style="font-size: 0.88rem;">
                    <i class="bi bi-clipboard-check-fill me-1.5 text-teal"></i> Recommended Officer Preventive Actions
                </h6>
                <% if (actions.length > 0) { %>
                    <div class="d-flex flex-column gap-2">
                        <% actions.forEach(function(action, idx) { %>
                            <div class="d-flex align-items-start gap-2.5 p-2 px-2.5 rounded-2" style="background: #141414; border: 1px solid rgba(255, 255, 255, 0.06); font-size: 0.82rem;">
                                <span class="badge rounded-circle px-2 py-0.5" style="background: rgba(6, 182, 212, 0.18); color: #22D3EE; border: 1px solid rgba(6, 182, 212, 0.35); font-weight: bold; font-size: 0.7rem;"><%= idx + 1 %></span>
                                <span style="color: #E2E8F0;"><%= action %></span>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="text-muted small mb-0">Standard milestone tracking recommended.</p>
                <% } %>
            </div>
        </div>

        <!-- Right: Case Parameter Snapshot -->
        <div class="col-lg-5">
            <div class="card border-0 rounded-3 p-3" style="background: #1E1E1E;">
                <h6 class="fw-bold text-white mb-2.5" style="font-size: 0.88rem;">
                    <i class="bi bi-info-circle-fill text-teal me-1.5"></i> Case Profile Summary
                </h6>
                <table class="table table-sm table-borderless mb-0" style="font-size: 0.82rem;">
                    <tbody>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-1.5 text-muted">Landowners Affected</td>
                            <td class="fw-bold text-end py-1.5 text-white"><%= item.affected_owner_count || 0 %> Owners</td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-1.5 text-muted">Compensation Amount</td>
                            <td class="fw-bold text-end py-1.5 text-white">₹ <%= item.compensation_estimate_inr_lakh || 0 %> Lakhs</td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-1.5 text-muted">Funding In Escrow</td>
                            <td class="fw-bold text-end py-1.5">
                                <span class="badge <%= item.compensation_funding_available ? 'escrow-badge-available' : 'escrow-badge-pending' %>">
                                    <%= item.compensation_funding_available ? 'Available' : 'Pending' %>
                                </span>
                            </td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-1.5 text-muted">Multi-Village Jurisdiction</td>
                            <td class="fw-bold text-end py-1.5 text-white"><%= item.is_multi_village ? 'Yes' : 'No' %></td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-1.5 text-muted">Current Notification</td>
                            <td class="fw-bold text-end py-1.5 text-white"><%= item.notification_stage || 'N/A' %></td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-1.5 text-muted">Days Elapsed</td>
                            <td class="fw-bold text-end py-1.5 text-white"><%= item.days_since_case_opened || 0 %> Days</td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-1.5 text-muted">Award Declared</td>
                            <td class="fw-bold text-end py-1.5 text-white"><%= awardPercentStr %></td>
                        </tr>
                        <tr>
                            <td class="py-1.5 text-muted">Physical Possession</td>
                            <td class="fw-bold text-end py-1.5 text-white"><%= possessionPercentStr %></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Bottom Navigation -->
            <div class="d-flex gap-2 mt-3">
                <a href="/predict" class="btn btn-teal flex-grow-1 py-1.5 fw-semibold d-flex align-items-center justify-content-center gap-1.5" style="font-size: 0.82rem; border-radius: 8px;">
                    <i class="bi bi-plus-circle me-1"></i> New Assessment
                </a>
                <a href="/history" class="btn flex-grow-1 py-1.5 fw-semibold d-flex align-items-center justify-content-center gap-1.5" style="background: #1E1E1E; color: #FFFFFF; border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; font-size: 0.82rem;">
                    <i class="bi bi-card-list me-1"></i> View All History
                </a>
            </div>
        </div>

    </div>

</div>

<!-- Chart.js for SHAP -->
<% if (shapData.length > 0) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script id="shap-data" type="application/json">
<%- JSON.stringify(shapData) %>
</script>
<script>
(function() {
    const dataEl = document.getElementById('shap-data');
    if (!dataEl) return;
    let shap = [];
    try {
        shap = JSON.parse(dataEl.textContent || '[]');
    } catch (e) {
        shap = [];
    }
    const canvas = document.getElementById('shapChart');
    if (!canvas || !shap.length) return;

    const labels  = shap.map(s => s.feature);
    const values  = shap.map(s => s.shap_value);
    const colors  = shap.map(s => s.shap_value > 0 ? '#EF4444' : '#10B981');
    const borders = shap.map(s => s.shap_value > 0 ? 'rgba(239, 68, 68, 0.8)' : 'rgba(16, 185, 129, 0.8)');

    new Chart(canvas, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'SHAP Value',
                data: values,
                backgroundColor: colors,
                borderColor: borders,
                borderWidth: 1,
                borderRadius: 4,
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => {
                            const s = shap[ctx.dataIndex];
                            return ` ${s.direction} by ${s.impact_pct}% (SHAP: ${s.shap_value > 0 ? '+' : ''}${s.shap_value})`;
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { color: 'rgba(255,255,255,0.06)' },
                    ticks: { 
                        color: '#94A3B8',
                        font: { size: 10 },
                        callback: v => (v > 0 ? '+' : '') + (v * 100).toFixed(1) + '%' 
                    }
                },
                y: { 
                    grid: { display: false },
                    ticks: { color: '#CBD5E1', font: { size: 10.5 } }
                }
            }
        }
    });
})();
</script>
<% } %>

<script>
(function() {
    var bar = document.getElementById('delayProgressBar');
    if (bar) {
        var w = bar.getAttribute('data-width') || '0';
        bar.style.width = w + '%';
    }
})();
</script>
